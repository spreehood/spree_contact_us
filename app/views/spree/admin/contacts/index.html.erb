<% content_for :page_title do %>
  <%= plural_resource_name(Spree::Contact) %>
<% end %>

<% if @contacts.any? %>
  <table class="table border rounded sortable" data-sortable-link="<%= update_positions_admin_vendors_url %>">
    <thead>
      <tr>
        <th>
          <%= Spree.t('spree_contact_us.name') %>
        </th>
        <th>
          <%= Spree.t('spree_contact_us.email') %>
        </th>
        <th>
          <%= Spree.t('spree_contact_us.phone') %>
        </th>
        <th>
          <%= Spree.t('spree_contact_us.subject') %>
        </th>
        <th>
          <%= Spree.t('spree_contact_us.message') %>
        </th>
        <th>
          <%= Spree.t('spree_contact_us.actions') %>
        </th>
      </tr>
    </thead>
    <tbody>
      <% @contacts.each do |contact| %>
        <tr id="<%= spree_dom_id contact %>" data-hook="vendors_row">
          <td>
            <%= contact.name rescue nil %>
          </td>
          <td>
            <%= contact.email %>
          </td>
          <td>
            <%= contact.phone %>
          </td>
          <td>
            <%= contact.subject %>
          </td>
          <td>
            <%= contact.message %>
          </td>
          <td>
            <%= link_to (svg_icon name: "send.svg", width: '20', height: '20'), "mailto:#{contact.email}" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-info alpha twelve columns no-objects-found">
    <%= Spree.t(:no_resource_found, resource: plural_resource_name(Spree::Contact)) %>
  </div>
<% end %>